+            *flatten(q_rows),
+            *flatten(kv_rows),
+            *flatten(orders),
+            *flatten(start_rows),
+            *flatten(last_rows),
+            *slots,
+            *([0] * (r - n)),
+            *[state.length for state in states],
+            *([0] * (r - n)),
+            *limits,
+            *([0] * (r - n)),
+            *flatten(sequences),
+        ]
