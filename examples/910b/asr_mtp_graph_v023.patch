+    query: torch.Tensor
+    key: torch.Tensor
+    value: torch.Tensor
+    output: torch.Tensor
+    softmax_lse: torch.Tensor
+    workspace: torch.Tensor
+    scale: float
+    handle: object = None
+    event: object = None
+    binding: object = None
+
