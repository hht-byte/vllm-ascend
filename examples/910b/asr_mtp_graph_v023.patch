+            arena.scratch_offset // self.row_width
+            + torch.arange(
+                token_size * cfg.num_key_value_heads * cfg.head_dim // self.row_width,
+                device=device,
+            )
+        ).view(token_size, cfg.num_key_value_heads, cfg.head_dim // self.row_width)
