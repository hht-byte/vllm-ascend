+# SPDX-License-Identifier: Apache-2.0
+"""Bounded, independent auxiliary graphs; target forward/verification is untouched."""
+
+import logging
+from collections import Counter
+from dataclasses import dataclass
+from math import gcd
+from time import perf_counter
+
+import torch
+from torch.nn import functional as F
+
+try:
+    from .asr_mtp_fused import add_rms_norm
+    from .asr_mtp_heads import project_norm_rope
+    from .asr_mtp_row_copy import prepare_row_writer
+    from .asr_mtp_staging import UploadBatch
+except ImportError:
+    from asr_mtp_fused import add_rms_norm
+    from asr_mtp_heads import project_norm_rope
+    from asr_mtp_row_copy import prepare_row_writer
+    from asr_mtp_staging import UploadBatch
+
+logger = logging.getLogger(__name__)
+MAX_MTP_GRAPHS = 64
+
+
+def validate_graph_runner(runner):
+    if getattr(runner.model_config, "enforce_eager", False):
+        raise ValueError("asr_mtp.graph_mode=full conflicts with enforce_eager=True")
+    if any(
+        cls.__module__.startswith("vllm_ascend._310p") for cls in type(runner).__mro__
+    ):
+        raise ValueError(
+            "ASR MTP full graphs require the 910B worker memory path; "
+            "310P auxiliary graph memory accounting is not supported"
+        )
+
+
+@dataclass(frozen=True)
+class GraphOptions:
+    max_batch: int
+    queries: tuple[int, ...]
+    context: int
+    tokens: tuple[int, ...] = ()
+    profile_stages: bool = False
+    row_write_backend: str = "auto"
+    head_counts: tuple[int, ...] = ()
+
+    def scratch_elements(self, config):
+        # A positive dummy query must cover the full non-PA TND KV tail even
+        # when real queries exactly fill the logical token bucket.
+        rows = (
+            max(self.tokens) + 1 if self.tokens else self.max_batch * max(self.queries)
+        )
+        return rows * max(
+            config.hidden_size, config.num_key_value_heads * config.head_dim
+        )
+
+
+def graph_options(settings, *, context, slots, max_batch, head_counts=()):
+    head_counts = tuple(sorted(set(head_counts)))
+    variants = max(1, len(head_counts))
+    row_write_backend = settings.get("row_write_backend", "auto")
+    if row_write_backend not in ("auto", "triton", "scatter_nd"):
+        raise ValueError("asr_mtp.row_write_backend must be auto, triton or scatter_nd")
+    profile_stages = settings.get("profile_stages", False)
+    if type(profile_stages) is not bool:
+        raise ValueError("asr_mtp.profile_stages must be a bool")
+    mode = settings.get("graph_mode", "off")
+    if mode not in ("off", "full"):
+        raise ValueError("asr_mtp.graph_mode must be off or full")
+    if mode == "off":
+        return None
+    capacity = settings.get("graph_context_tokens", min(128, context))
+    batch = settings.get("graph_max_batch_size", 8)
+    if type(capacity) is not int or not 0 < capacity <= context:
+        raise ValueError(
+            "asr_mtp.graph_context_tokens exceeds the auxiliary context capacity"
+        )
+    if type(batch) is not int or batch < 1:
+        raise ValueError("asr_mtp.graph_max_batch_size must be a positive integer")
+    batch = min(batch, slots, max_batch)
+    if batch < 1:
+        raise ValueError("asr_mtp graphs require at least one request slot")
+    if "graph_token_sizes" in settings:
+        tokens = settings["graph_token_sizes"]
+        if (
+            not isinstance(tokens, (list, tuple))
+            or not tokens
+            or any(type(t) is not int or t < 1 for t in tokens)
+        ):
+            raise ValueError(
+                "asr_mtp.graph_token_sizes must contain positive token capacities"
+            )
+        tokens = tuple(sorted(set(tokens)))
+        if len(tokens) * variants > MAX_MTP_GRAPHS:
+            raise ValueError(
+                f"asr_mtp graph count must be between 1 and {MAX_MTP_GRAPHS}"
+            )
+        return GraphOptions(
+            batch, (), capacity, tokens, profile_stages, row_write_backend, head_counts
+        )
+    queries = settings.get("graph_query_sizes", (min(8, capacity), min(64, capacity)))
+    if (
+        not isinstance(queries, (list, tuple))
+        or not queries
+        or any(type(q) is not int or not 0 < q <= capacity for q in queries)
+    ):
+        raise ValueError(
+            "asr_mtp.graph_query_sizes must contain positive query capacities"
+        )
+    queries = tuple(sorted(set(queries)))
+    if batch * len(queries) * variants > MAX_MTP_GRAPHS:
+        raise ValueError(f"asr_mtp graph count must be between 1 and {MAX_MTP_GRAPHS}")
+    return GraphOptions(
+        batch,
+        queries,
+        capacity,
+        profile_stages=profile_stages,
+        row_write_backend=row_write_backend,
+        head_counts=head_counts,
+    )
+
+
+def captured_depth(options, heads, limit):
+    depths = getattr(options, "head_counts", ())
+    if not depths:
+        return heads if limit == heads else None
+    return next((depth for depth in depths if limit <= depth), None)
+
+
+def depth_key(options, depth, key):
+    return (depth, key) if getattr(options, "head_counts", ()) else key
+
