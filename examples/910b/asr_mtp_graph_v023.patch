+                    F.scaled_dot_product_attention(
+                        q,
+                        k.repeat_interleave(groups, 0),
+                        v.repeat_interleave(groups, 0),
+                        attn_mask=allowed[None],
+                        dropout_p=0.0,
+                        scale=scale,
+                    ).transpose(0, 1)
+                )
+                previous_q, previous_kv = q_end, kv_end
