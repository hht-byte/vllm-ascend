+        kv_width = cfg.num_key_value_heads * cap * cfg.head_dim // self.row_width
+        stride = self.arena.storage.shape[1] // self.row_width
+        sequence = self.sequence.clone()
+        for d, block in enumerate(self.heads.blocks):
