+                    "ASR_MTP_CONTEXT_MISS batch_size=%d max_context=%d context_limit=%d "
+                    "max_fresh_query=%d query_limit=%d miss_count=%d",
+                    len(states),
+                    max_context,
+                    self.options.context,
+                    max_fresh_query,
+                    max(self.options.queries),
+                    self.stats["miss_context"],
