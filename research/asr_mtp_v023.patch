+import torch
+from torch.nn import functional as F
+
+CAUSAL_MASK_SIZE = 2048
+UNLIMITED_PRE_TOKENS = 2147483647
+
+
+@dataclass
+class _Task:
+    query: torch.Tensor
+    key: torch.Tensor
+    value: torch.Tensor
+    output: torch.Tensor
+    softmax_lse: torch.Tensor
+    workspace: torch.Tensor
+    scale: float
+    handle: object = None
+    event: object = None
+    binding: object = None
